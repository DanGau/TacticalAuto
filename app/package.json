{
  "name": "tactical-auto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "sim": "tsx src/sim/cli.ts",
    "eye": "tsx eye/eye.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run sim -- --runs=50",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
